# ─────────────────────────────────────────────
#  clawstack — environment variables
#  Copy this to .env and fill in your values
#  Run: cp .env.example .env
# ─────────────────────────────────────────────

# ── AI Providers (at least one required) ──────
OPENROUTER_API_KEY=sk-or-v1-your-key-here
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── OpenClaw Gateway ──────────────────────────
# Shared gateway password. Mission Control uses the same value automatically
# when it connects to OpenClaw.
OPENCLAW_GATEWAY_PASSWORD=
OPENCLAW_PORT=18789

# ── Mission Control ───────────────────────────
MC_PORT=4000
# Password for the browser dashboard. If omitted, `clawstack start` will
# generate one automatically and append it to `.env`.
MC_ADMIN_PASSWORD=
# Optional explicit session signing secret. If omitted, `clawstack start`
# generates one automatically.
MC_SESSION_SECRET=
# Set to true only when Mission Control is served over HTTPS.
MC_SECURE_COOKIES=false

# ── PostgreSQL ────────────────────────────────
POSTGRES_USER=clawstack
POSTGRES_PASSWORD=changeme
POSTGRES_DB=clawstack

# ── Ports (optional overrides) ────────────────
# NGINX_PORT=80
