# ─────────────────────────────────────────────
#  agentStack — environment variables
#  Copy this to .env and fill in your values
#  Run: cp .env.example .env
# ─────────────────────────────────────────────

# ── AI Providers (at least one required) ──────
OPENROUTER_API_KEY=sk-or-v1-your-key-here
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── OpenClaw Gateway ──────────────────────────
# Optional gateway password. Control-plane uses the same value automatically
# when OpenClaw is enabled.
OPENCLAW_GATEWAY_PASSWORD=
OPENCLAW_PORT=18789

# ── Mission Control ───────────────────────────
MC_PORT=4000
CONTROL_PLANE_PORT=4100
ORCHESTRATOR_PORT=4200
# Password for the browser dashboard. If omitted, `agentstack start` will
# generate one automatically and append it to `.env`.
MC_ADMIN_PASSWORD=
# Optional explicit session signing secret. If omitted, `agentstack start`
# generates one automatically.
MC_SESSION_SECRET=
# Optional dedicated JWT signing secret for GitHub OAuth sessions.
# If omitted, Mission Control falls back to MC_SESSION_SECRET.
AUTH_JWT_SECRET=
# Optional GitHub OAuth settings. When set, GitHub sign-in becomes the
# primary auth path and the local password flow remains as a fallback only
# when OAuth is not configured.
APP_BASE_URL=http://localhost
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Set to true only when Mission Control is served over HTTPS.
MC_SECURE_COOKIES=false
# Shared internal token for Mission Control -> Control Plane calls.
AGENTSTACK_INTERNAL_TOKEN=

# ── PostgreSQL ────────────────────────────────
POSTGRES_USER=agentstack
POSTGRES_PASSWORD=changeme
POSTGRES_DB=agentstack

# ── Ports (optional overrides) ────────────────
# NGINX_PORT=80
